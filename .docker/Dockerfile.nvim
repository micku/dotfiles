# syntax=docker/dockerfile:1

ARG DEBIAN_VERSION=sid

FROM debian:${DEBIAN_VERSION}-slim

ARG EXTRA_PACKAGES="build-essential fzf curl nodejs npm golang-go unzip"
ARG NVIM_CONFIG_REPO=https://github.com/micku/dotfiles.git
ARG NVIM_CONFIG_BRANCH=master

RUN apt update

RUN apt install -y neovim ttyd stow git ${EXTRA_PACKAGES}

RUN git clone --depth 1 \
      #--recurse-submodules -j8 \
      --branch "${NVIM_CONFIG_BRANCH}" \
      "${NVIM_CONFIG_REPO}" /root/dotfiles

# TODO: for this kind of build, the Nvim config is too bloated.
#  It needs to be stripped down so that useless plugins are not
#  installed (ie. Go formatter, Java LS, ...)
# TODO: Change the submodules to https so they can be
#  downloaded without SSH key
RUN cd /root/dotfiles && stow nvim
RUN nvim --headless "+Lazy! build telescope-fzf-native.nvim" +qa
RUN nvim --headless "+Lazy! sync" +qa

WORKDIR /workspace

EXPOSE 7681

CMD ["ttyd", "-W", "-p", "7681", "nvim", "."]
